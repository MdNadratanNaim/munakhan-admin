# "local" (default) reads/writes local-data/ — no repos needed yet.
# "github" switches the whole app onto the real repos below.
# NOTE: DATABASE_REPO is filled in below, but WEBSITE_REPO is still empty —
# GithubProvider requires both, so flipping this to "github" before
# WEBSITE_REPO is set will throw on startup. See README/chat for what the
# website repo needs to contain.
DATA_PROVIDER=github


# --- Only needed once DATA_PROVIDER=github -----------------------------
# Fine-grained PAT (or GitHub App token) with Contents: read+write on the
# database repo, and at least Contents: read on the website repo.
# In Cloudflare Pages this is set as an encrypted secret, never committed.
GITHUB_TOKEN=github_pat_**********************************************************


# Optional private website repository containing the index instead. When set,
# its database index is used and GITHUB_TOKEN is required for loading it.
# "owner/name" for each repo.
WEBSITE_REPO=manali-earth/portfolio
WEBSITE_BRANCH=main
# WEBSITE_INDEX_PATH=database/database.json


# The database repository contains database.json and all page JSON files.
DATABASE_REPO=manali-earth/database
DATABASE_BRANCH=main
# Optional; defaults to database.json at the database repository root.
DATABASE_INDEX_PATH=database.json

# The deployed website the live preview is built from (fetched on demand, nothing to sync).
WEBSITE_URL=https://munakhan.pages.dev

# Hard cap on the size of the database repo's photos/ directory, in MB (default 80).
# A save that would exceed it is refused before anything is pushed to GitHub.
PHOTOS_STORAGE_LIMIT_MB=80


# --- Login ---------------------------------------------------------------
# ADMIN_PASSWORD_HASH is a salted hash of the admin password. Make it with:
#   node scripts/hash-password.mjs "a password of at least 12 characters"
# and paste the printed pbkdf2$... value. (The older unsalted SHA-256 hex digest still works, but is quick to guess
# offline, so replace it with the salted form.)
ADMIN_PASSWORD_HASH=put_the_pbkdf2_hash_here

# AUTH_SESSION_SECRET is any long random string; it signs the login cookie.
# Generate it:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (or: openssl rand -hex 32)
# Changing either value above logs everyone out.
AUTH_SESSION_SECRET=put_the_random_secret_here

# Locally, put both in .env.local. On Cloudflare they are not in wrangler.toml: add them as secrets on the Worker
# (dashboard: Settings > Variables and Secrets, or `npx wrangler secret put ADMIN_PASSWORD_HASH`
# and `npx wrangler secret put AUTH_SESSION_SECRET`). Never commit real values.
